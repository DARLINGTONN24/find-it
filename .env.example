NODE_ENV=production
PORT=3000
SESSION_SECRET=generate-a-long-random-secret
LOOKUP_SECRET=generate-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
DB_FILE=./data/findit.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
PUBLIC_BASE_URL=http://localhost:3000

# Automated backups (see SECURITY.md "Backups" section)
BACKUP_DIR=./data/backups
BACKUP_KEEP_COUNT=14

# Comma-separated list of additional trusted origins allowed to make cross-origin,
# credentialed requests to this API (beyond the built-in Capacitor/localhost defaults).
# Only needed if you host a web frontend on a different domain than this API, or add
# other native app origins later. Leave blank if unsure.
MOBILE_CORS_ORIGINS=